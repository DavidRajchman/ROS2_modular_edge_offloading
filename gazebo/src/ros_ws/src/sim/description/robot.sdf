<?xml version="1.0" ?>
<!--
  Gazebo Ackermann steering plugin demo

  Try sending commands:

    gz topic -t "/model/vehicle_blue/cmd_vel" -m gz.msgs.Twist -p "linear: {x: 0.5}, angular: {z: 0.1}"

  Listen to odometry:

    gz topic -e -t /model/vehicle_blue/odometry

-->
<sdf version="1.6">
  <world name="ackermann_steering">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- imu -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>
    <!-- lidar -->
    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>50</mu>
              </ode>
              <bullet>
                <friction>1</friction>
                <rolling_friction>0.1</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name='vehicle_blue'>
      <pose>0 0 0.12 0 00 0</pose>
    
    <!--baselink  -->
      <link name='chassis'>
        <pose>0.16 0 0 0 0 0</pose>
        <inertial>
          <mass>6000.0</mass>
          <inertia>
            <ixx>0.126164</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.416519</iyy>
            <iyz>0</iyz>
            <izz>0.481014</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <pose>0.16 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.65 0.175 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 1.0 1</ambient>
            <diffuse>0.5 0.5 1.0 1</diffuse>
            <specular>0.0 0.0 1.0 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <pose>0.16 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.65 0.175 0.1</size>
            </box>
          </geometry>
        </collision>
      </link>


    <!-- superstructure -->
    <link name='superstructure_link'>
        <pose relative_to="chassis">0 0 0.0725 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.126164</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.416519</iyy>
            <iyz>0</iyz>
            <izz>0.481014</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.3 0.175 0.045</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 1.0 1</ambient>
            <diffuse>0.5 0.5 1.0 1</diffuse>
            <specular>0.0 0.0 1.0 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.3 0.175 0.045</size>
            </box>
          </geometry>
        </collision>
      </link>
    <joint name="superstructure_joint" type="fixed">
        <parent>chassis</parent>
        <child>superstructure_link</child>
        <pose relative_to="chassis">0 0 0.0725 0 0 0</pose>
    </joint>







    <!-- rear wheels -->
      <link name='rear_left_wheel'>
        <pose relative_to="chassis">-0.08 0.11 -0.0725 0 0 0</pose>

        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.145833</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.145833</iyy>
            <iyz>0</iyz>
            <izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.5</mu>
                <mu2>1.0</mu2>
                <fdir1>0 0 1</fdir1>
              </ode>
              <bullet>
                <friction>0.5</friction>
                <friction2>1</friction2>
                <rolling_friction>0.1</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
      </link>


      <link name='rear_right_wheel'>
        <pose relative_to="chassis">-0.08 -0.11 -0.0725 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.145833</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.145833</iyy>
            <iyz>0</iyz>
            <izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.5</mu>
                <mu2>1.0</mu2>
                <fdir1>0 0 1</fdir1>
              </ode>
              <bullet>
                <friction>0.5</friction>
                <friction2>1</friction2>
                <rolling_friction>0.5</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
      </link>










      <!-- mid wheels -->
        <link name='mid_left_wheel'>
        <pose relative_to="chassis">0.065 0.11 -0.0725 0 0 0</pose>

        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.145833</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.145833</iyy>
            <iyz>0</iyz>
            <izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.5</mu>
                <mu2>1.0</mu2>
                <fdir1>0 0 1</fdir1>
              </ode>
              <bullet>
                <friction>0.5</friction>
                <friction2>1</friction2>
                <rolling_friction>0.1</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
      </link>


      <link name='mid_right_wheel'>
        <pose relative_to="chassis">0.065 -0.11 -0.0725 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.145833</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.145833</iyy>
            <iyz>0</iyz>
            <izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.5</mu>
                <mu2>1.0</mu2>
                <fdir1>0 0 1</fdir1>
              </ode>
              <bullet>
                <friction>0.5</friction>
                <friction2>1</friction2>
                <rolling_friction>0.5</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
      </link>
     
     
     
     
     
     
     
     
     <!-- front wheels -->
      <link name='front_left_wheel'>
        <pose relative_to="chassis">0.375 0.11 -0.0725 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.145833</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.145833</iyy>
            <iyz>0</iyz>
            <izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.5</mu>
                <mu2>1.0</mu2>
                <fdir1>0 0 1</fdir1>
              </ode>
              <bullet>
                <friction>0.5</friction>
                <friction2>1</friction2>
                <rolling_friction>0.5</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
      </link>

      <link name='front_right_wheel'>
      <pose relative_to="chassis">0.375 -0.11 -0.0725 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.145833</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.145833</iyy>
            <iyz>0</iyz>
            <izz>0.125</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name='collision'>
            <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <length>0.0575</length>
              <radius>0.045</radius>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.5</mu>
                <mu2>1.0</mu2>
                <fdir1>0 0 1</fdir1>
              </ode>
              <bullet>
                <friction>0.5</friction>
                <friction2>1</friction2>
                <rolling_friction>0.1</rolling_friction>
              </bullet>
            </friction>
          </surface>
        </collision>
      </link>



        <!-- steering links -->
      <link name="front_left_wheel_steering_link">
        <pose relative_to="chassis">0.375 0.11 -0.0725 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0153</ixx>
            <iyy>0.025</iyy>
            <izz>0.0153</izz>
          </inertia>
        </inertial>
      </link>

      <link name="front_right_wheel_steering_link">
        <pose relative_to="chassis">0.375 -0.11 -0.0725 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0153</ixx>
            <iyy>0.025</iyy>
            <izz>0.0153</izz>
          </inertia>
        </inertial>
      </link>

        <!-- lidar link  -->
        <link name="laser_frame">
            <pose relative_to="superstructure_link">0.08 0 0.0525 0 0 0</pose>
            <visual name="laser_visual">
                <geometry>
                    <cylinder>
                        <radius>0.035</radius>
                        <length>0.06</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>1.0 0.0 0.0 1.0</ambient> 
                    <diffuse>1.0 0.0 0.0 1.0</diffuse>
                    <specular>0.0 0.0 0.0 1.0</specular>
                </material>
            </visual>
            <sensor name='gpu_lidar' type='gpu_lidar'>"
                <pose relative_to='lidar_frame'>0 0 0 0 0 0</pose>
                <topic>lidar</topic>
                <update_rate>10</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>640</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.1415</min_angle>
                            <max_angle>3.1415</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>0.01</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.08</min>
                        <max>10.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </ray>
                <always_on>1</always_on>
                <visualize>true</visualize>
            </sensor>
        </link>

        <!-- camera -->
        <link name="camera_link">
            <pose relative_to="chassis">0.475 0 0.06 0 0 0</pose>
            <visual name="camera_visual">
                <geometry>
                    <box>
                        <size>0.02 0.085 0.02</size> 
                    </box>
                </geometry>
                <material>
                    <ambient>1.0 0.0 0.0 1.0</ambient> 
                    <diffuse>1.0 0.0 0.0 1.0</diffuse>
                    <specular>0.0 0.0 0.0 1.0</specular>
                </material>
            </visual>

            <sensor name="camera" type="camera">
                <pose> 0 0 0 0 0 0 </pose>
                <visualize>true</visualize>
                <update_rate>10</update_rate>
                <camera>
                    <camera_info_topic>camera/camera_info</camera_info_topic>
                    <horizontal_fov>1.089</horizontal_fov>
                    <image>
                        <format>R8G8B8</format>
                        <width>640</width>
                        <height>480</height>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>8.0</far>
                    </clip>
                </camera>
                <topic>camera/image_raw</topic>
            </sensor>
        </link>


        <!-- imu -->
        <link name="imu_link">
            <pose relative_to="chassis">0 0 0 0 0 0</pose>
            <visual name="imu_visual">
                <geometry>
                    <box>
                        <size>0.045 0.06 0.01</size> 
                    </box>
                </geometry>
                <material>
                    <ambient>1.0 0.0 0.0 1.0</ambient> 
                    <diffuse>1.0 0.0 0.0 1.0</diffuse>
                    <specular>0.0 0.0 0.0 1.0</specular>
                </material>
            </visual>
            <sensor name="imu_sensor" type="imu">
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <topic>imu</topic>
            </sensor>
        </link>





        <!-- sensor links -->
        <joint name="laser_joint" type="fixed">
            <parent>superstructure_link</parent>
            <child>laser_frame</child>
        </joint>

        <joint name="camera_joint" type="fixed">
            <parent>chassis</parent>
            <child>camera_link</child>
        </joint>

        <joint name="imu_joint" type="fixed">
            <parent>chassis</parent>
            <child>imu_link</child>
        </joint>


        <!-- steering joints -->
      <joint name="front_left_wheel_steering_joint" type="revolute">
        <child>front_left_wheel_steering_link</child>
        <parent>chassis</parent>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-0.6</lower>
            <upper>+0.6</upper>
            <velocity>1.0</velocity>
            <effort>25</effort>
          </limit>
          <use_parent_model_frame>1</use_parent_model_frame>
        </axis>
      </joint>

      <joint name="front_right_wheel_steering_joint" type="revolute">
        <parent>chassis</parent>
        <child>front_right_wheel_steering_link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-0.6</lower>
            <upper>+0.6</upper>
            <velocity>1.0</velocity>
            <effort>25</effort>
          </limit>
        </axis>
      </joint>


        <!-- front joints  -->
      <joint name='front_left_wheel_joint' type='revolute'>
        <parent>front_left_wheel_steering_link</parent>
        <child>front_left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name='front_right_wheel_joint' type='revolute'>
        <parent>front_right_wheel_steering_link</parent>
        <child>front_right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>


        <!-- read joints -->
      <joint name='rear_left_wheel_joint' type='revolute'>
        <parent>chassis</parent>
        <child>rear_left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name='rear_right_wheel_joint' type='revolute'>
        <parent>chassis</parent>
        <child>rear_right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

    <!-- mid joints  -->
    <joint name='mid_left_wheel_joint' type='revolute'>
        <parent>chassis</parent>
        <child>mid_left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <joint name='mid_right_wheel_joint' type='revolute'>
        <parent>chassis</parent>
        <child>mid_right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-1.79769e+308</lower>
            <upper>1.79769e+308</upper>
          </limit>
        </axis>
      </joint>

      <plugin
        filename="gz-sim-ackermann-steering-system"
        name="gz::sim::systems::AckermannSteering">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <left_joint>mid_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <right_joint>mid_right_wheel_joint</right_joint>
        <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
        <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>
        <kingpin_width>0.22</kingpin_width>
        <steering_limit>0.7854</steering_limit>
        <wheel_base>0.4</wheel_base>
        <wheel_separation>0.22</wheel_separation>
